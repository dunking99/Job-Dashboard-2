// Job Dashboard — data model
//
// Design note: everything downstream (CVs, cover letters, STAR answers) is a
// *projection* of ExperienceAtom. Atoms are written once and reused in three
// registers. Nothing about a person's history is stored twice.
//
// SQLite has no native enum support in Prisma, so status-like columns are
// Strings constrained at the TypeScript layer (see src/lib/constants.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Profile — a singleton row describing the person doing the searching.
// ---------------------------------------------------------------------------

model Profile {
  id        String @id @default("singleton")

  fullName  String  @default("")
  headline  String  @default("")
  email     String  @default("")
  phone     String  @default("")
  location  String  @default("")
  linkedIn  String  @default("")
  website   String  @default("")

  // Personal statement / CV summary paragraph.
  summary   String  @default("")

  // Education — kept flat because most grads have one relevant qualification.
  degree         String @default("")
  university     String @default("")
  graduationYear String @default("")
  classification String @default("")

  // JSON string arrays. Drive match scoring and the "target" framing.
  targetRoles    String @default("[]")
  targetSectors  String @default("[]")
  targetLocations String @default("[]")

  // Voice calibration for AI generation — free text describing how you write.
  voiceNotes String @default("")

  weeklyApplicationTarget Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Experience bank — the source of truth.
// ---------------------------------------------------------------------------

model ExperienceAtom {
  id String @id @default(cuid())

  title        String
  category     String  @default("WORK") // ACADEMIC | WORK | LEADERSHIP | PROJECT | CERTIFICATION | VOLUNTEER
  organisation String  @default("")
  role         String  @default("")
  location     String  @default("")

  startDate DateTime?
  endDate   DateTime?
  ongoing   Boolean   @default(false)

  // Context: what the situation actually was. Not CV prose — raw material.
  summary String @default("")

  // The quantified outcome, if one exists. Free text so "500+ responses" and
  // "£12k" both fit naturally.
  metric String @default("")

  // STAR expansion. Lives on the atom so interview prep reuses the same record
  // rather than maintaining a parallel story bank.
  starSituation String @default("")
  starTask      String @default("")
  starAction    String @default("")
  starResult    String @default("")

  // Your own weighting of how strong this evidence is (1–5). Feeds ranking.
  impactScore Int     @default(3)
  isHeadline  Boolean @default(false)

  // Soft-delete so archived atoms stop appearing in tailoring without losing history.
  archived Boolean @default(false)

  bullets      BulletVariant[]
  skills       AtomSkill[]
  domains      Domain[]        @relation("AtomDomains")
  competencies Competency[]    @relation("AtomCompetencies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([archived])
}

// One atom, several phrasings. A CV bullet, a cover-letter sentence and a
// spoken interview line are different registers of the same fact.
model BulletVariant {
  id     String @id @default(cuid())
  atomId String
  atom   ExperienceAtom @relation(fields: [atomId], references: [id], onDelete: Cascade)

  text     String
  register String  @default("CV") // CV | CV_SHORT | COVER_LETTER | INTERVIEW
  isPrimary Boolean @default(false)

  // Set when generated by AI rather than written by hand, so drafts are visible.
  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([atomId])
}

model Skill {
  id   String @id @default(cuid())
  name String @unique

  kind        String @default("HARD") // HARD | SOFT | TOOL | LANGUAGE | METHOD
  proficiency Int    @default(3)      // 1–5, self-assessed
  notes       String @default("")

  // Alternate spellings the JD parser should treat as this skill, JSON array.
  // e.g. Stata -> ["stata"], Excel -> ["ms excel","microsoft excel","excel"]
  aliases String @default("[]")

  atoms AtomSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

// Explicit join so an atom can say *how strongly* it evidences a skill.
model AtomSkill {
  atomId  String
  skillId String
  atom    ExperienceAtom @relation(fields: [atomId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // 1–3. A passing mention vs. the thing the role was actually about.
  weight Int @default(2)

  @@id([atomId, skillId])
  @@index([skillId])
}

// Policy domain tags — the axis that matters for public-policy hiring.
model Domain {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  notes String @default("")

  atoms     ExperienceAtom[] @relation("AtomDomains")
  jobs      Job[]            @relation("JobDomains")
  companies Company[]        @relation("CompanyDomains")

  createdAt DateTime @default(now())
}

// Behavioural competencies — the axis interviews are scored on.
model Competency {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String @default("")

  // Civil Service Success Profiles and similar frameworks.
  framework String @default("GENERAL")

  atoms     ExperienceAtom[]    @relation("AtomCompetencies")
  questions PredictedQuestion[]

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Companies & jobs
// ---------------------------------------------------------------------------

model Company {
  id   String @id @default(cuid())
  name String @unique

  website String @default("")
  sector  String @default("") // GOVERNMENT | THINK_TANK | NGO | CONSULTANCY | PRIVATE | ACADEMIC | POLITICAL | REGULATOR | OTHER
  size    String @default("")
  hq      String @default("")

  // Research dossier. Populated by hand or by the AI research action.
  whatTheyDo      String @default("")
  recentNews      String @default("")
  policyPositions String @default("")
  cultureNotes    String @default("")
  whyThisOrg      String @default("")
  competitors     String @default("")
  keyPeople       String @default("[]") // JSON array of {name, role, note}
  sources         String @default("[]") // JSON array of {label, url}

  researchedAt DateTime?

  domains  Domain[]  @relation("CompanyDomains")
  jobs     Job[]
  contacts Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id String @id @default(cuid())

  title     String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Denormalised so a job can be captured before its company record exists.
  companyName String @default("")

  location  String @default("")
  workMode  String @default("UNKNOWN") // ONSITE | HYBRID | REMOTE | UNKNOWN
  contract  String @default("") // Permanent, FTC, Internship, Grad scheme...
  salaryText String @default("")
  salaryMin Int?
  salaryMax Int?

  url    String @default("")
  source String @default("") // LinkedIn, Civil Service Jobs, W4MP, direct...

  // The JD snapshot. Postings get taken down; keep our own copy.
  rawDescription String @default("")

  postedDate DateTime?
  deadline   DateTime?

  // Pipeline position.
  status         String   @default("SAVED")
  stageChangedAt DateTime @default(now())
  appliedAt      DateTime?
  closedAt       DateTime?
  outcome        String   @default("") // OFFER | REJECTED | WITHDRAWN | GHOSTED | ""

  // Ordering within a kanban column.
  boardOrder Int @default(0)

  // --- Analysis output (deterministic scorer + optional AI enrichment) ---
  matchScore     Int?
  matchBreakdown String @default("{}") // JSON: per-component scores
  gaps           String @default("[]") // JSON array of unmet requirements
  redFlags       String @default("[]") // JSON array of {label, severity, evidence}

  extractedSkills String @default("[]") // JSON array of {name, kind, required}
  yearsRequired   Int?

  // The three-bullet executive dossier.
  fitSummary       String @default("")
  positioningAngle String @default("")
  riskNotes        String @default("")

  analysedAt DateTime?

  priority Int    @default(3) // 1–5
  notes    String @default("")

  domains         Domain[]            @relation("JobDomains")
  documents       Document[]
  interviews      InterviewEvent[]
  questions       PredictedQuestion[]
  interactions    Interaction[]
  tasks           Task[]
  aiCalls         AiCall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([companyId])
  @@index([deadline])
}

// ---------------------------------------------------------------------------
// Generated documents
// ---------------------------------------------------------------------------

model Document {
  id String @id @default(cuid())

  kind  String  @default("CV") // CV | COVER_LETTER
  label String  @default("")

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // For a CV: JSON describing sections and the atom/bullet ids composing them,
  // so the document stays traceable back to the bank.
  // For a cover letter: JSON with the paragraph list.
  structure String @default("{}")

  // Flattened plain text — what gets exported, keyword-scanned and copied.
  renderedText String @default("")

  // ATS analysis of renderedText against the job's JD.
  atsScore        Int?
  keywordCoverage String @default("{}") // JSON: {matched:[], missing:[]}
  atsIssues       String @default("[]") // JSON array of {label, severity, hint}

  isMaster Boolean @default(false) // A base CV not tied to any one job.
  isFinal  Boolean @default(false)
  version  Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// People & communications
// ---------------------------------------------------------------------------

model Contact {
  id   String @id @default(cuid())
  name String

  role      String  @default("")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyName String @default("")

  email    String @default("")
  phone    String @default("")
  linkedIn String @default("")

  relationship String @default("COLD") // COLD | OUTREACH_SENT | WARM | MET | REFERRER | RECRUITER | INTERVIEWER
  notes        String @default("")

  lastContactedAt DateTime?
  nextActionAt    DateTime?
  nextActionNote  String    @default("")

  interactions Interaction[]
  tasks        Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([relationship])
}

model Interaction {
  id String @id @default(cuid())

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  kind      String @default("NOTE") // EMAIL | CALL | LINKEDIN | MEETING | APPLICATION | INTERVIEW | NOTE
  direction String @default("OUT")  // IN | OUT | NA
  subject   String @default("")
  body      String @default("")

  occurredAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Interview preparation
// ---------------------------------------------------------------------------

model InterviewEvent {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  kind         String @default("SCREENING") // SCREENING | TECHNICAL | PANEL | FINAL | INFORMAL | ASSESSMENT_CENTRE
  scheduledAt  DateTime
  durationMins Int      @default(45)
  format       String   @default("VIDEO") // VIDEO | PHONE | IN_PERSON
  locationOrLink String @default("")
  interviewers   String @default("[]") // JSON array of {name, role}

  prepStatus String @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | READY
  prepNotes  String @default("")
  debrief    String @default("")
  outcome    String @default("") // PASSED | REJECTED | PENDING | ""

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([scheduledAt])
}

model PredictedQuestion {
  id String @id @default(cuid())

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  text String
  kind String @default("BEHAVIOURAL") // BEHAVIOURAL | TECHNICAL | MOTIVATIONAL | CASE | POLICY | COMPETENCY

  competencyId String?
  competency   Competency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)

  // Which atoms answer this well — the bridge back to the bank.
  suggestedAtomIds String @default("[]") // JSON array of atom ids
  rationale        String @default("")
  difficulty       Int    @default(3)

  isCore Boolean @default(false) // Part of the standing bank rather than job-specific.

  answers PracticeAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([kind])
}

model PracticeAnswer {
  id String @id @default(cuid())

  questionId String
  question   PredictedQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerText String
  // Structural analysis: STAR coverage, length, metric presence, filler.
  analysis   String @default("{}") // JSON
  score      Int?
  feedback   String @default("")

  createdAt DateTime @default(now())

  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Work queue
// ---------------------------------------------------------------------------

// Manual tasks only. Derived work (stale applications, upcoming interviews,
// approaching deadlines) is computed at read time in lib/actionQueue.ts and is
// deliberately NOT stored — stored to-dos drift out of sync with reality.
model Task {
  id String @id @default(cuid())

  title  String
  detail String @default("")
  kind   String @default("GENERAL") // GENERAL | FOLLOW_UP | PREP | ADMIN | RESEARCH

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  dueAt  DateTime?
  done   Boolean   @default(false)
  doneAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([done])
  @@index([dueAt])
}

// ---------------------------------------------------------------------------
// AI layer
// ---------------------------------------------------------------------------

// Every AI generation is logged. In bridge mode (no API key) the row is created
// with status PENDING and holds the prompt for copy-paste; the pasted response
// is written back to the same row, so both modes share one code path.
model AiCall {
  id String @id @default(cuid())

  kind   String // JOB_ANALYSIS | CV_TAILOR | COVER_LETTER | COMPANY_DOSSIER | QUESTIONS | ANSWER_FEEDBACK | ATOM_EXTRACT | BULLET_REWRITE
  mode   String @default("API") // API | BRIDGE
  status String @default("PENDING") // PENDING | COMPLETE | FAILED

  model        String @default("")
  systemPrompt String @default("")
  userPrompt   String @default("")
  responseText String @default("")
  errorText    String @default("")

  inputTokens  Int?
  outputTokens Int?
  durationMs   Int?

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Free-form context so a bridge response knows what to update on paste-back.
  targetType String @default("")
  targetId   String @default("")

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([kind])
}

// Simple key/value app settings (AI mode, onboarding state, UI preferences).
model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}
