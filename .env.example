# Local SQLite database file.
DATABASE_URL="file:./dev.db"
# --- AI engine (optional) ---------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to run in BRIDGE mode: the app builds a fully
# formed prompt for you to paste into Claude, and you paste the response back.
# Everything works in bridge mode; it is just manual.
#
# Set a key to run in API mode, where every AI action is one click.
# Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY="sk-ant-..."
# Model used for generation. Sonnet is the right default: fast and cheap enough
# to run on every job ingest.
ANTHROPIC_MODEL="claude-sonnet-5"
